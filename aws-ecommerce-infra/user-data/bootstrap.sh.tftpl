#!/bin/bash
set -euxo pipefail

exec > >(tee -a /var/log/ecommerce-bootstrap.log | logger -t ecommerce-bootstrap -s 2>/dev/console) 2>&1

dnf install -y python3 python3-pip awscli

install -d -o root -g root -m 0755 /opt/ecommerce

aws s3 cp "s3://${app_bucket}/${app_prefix}/app.py" /opt/ecommerce/app.py
aws s3 cp "s3://${app_bucket}/${app_prefix}/requirements.txt" /opt/ecommerce/requirements.txt

python3 -m venv /opt/ecommerce/venv
/opt/ecommerce/venv/bin/pip install --no-cache-dir -r /opt/ecommerce/requirements.txt

chown -R root:root /opt/ecommerce
chmod 0644 /opt/ecommerce/app.py /opt/ecommerce/requirements.txt

cat > /etc/systemd/system/ecommerce.service <<'UNIT'
[Unit]
Description=CloudWithChandu E-commerce Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/ecommerce
Environment=PORT=8080
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ecommerce/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now ecommerce.service
systemctl is-active --quiet ecommerce.service
